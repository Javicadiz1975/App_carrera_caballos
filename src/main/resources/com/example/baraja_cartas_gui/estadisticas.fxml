<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.baraja_cartas_gui.controladores.EstadisticasController"
      spacing="20" alignment="CENTER"
      style="-fx-padding: 30; -fx-background-color: #f4f4f9; -fx-background-radius: 10;">

    <!-- Título principal -->
    <Label text="Estadísticas de Palos Ganadores"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2a9d8f;" />

    <!-- Contenedor para las estadísticas -->
    <GridPane fx:id="estadisticasGrid" hgap="20" vgap="10"
              style="-fx-padding: 20; -fx-background-color: #ffffff; -fx-border-color: #e9c46a; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5;">
        <!-- Las estadísticas de los palos se generarán dinámicamente -->
    </GridPane>

    <!-- Botón de volver -->
    <Button text="Volver" onAction="#volver"
            style="-fx-padding: 10 20; -fx-font-size: 14px; -fx-background-color: #e76f51; -fx-text-fill: white; -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-weight: bold;" />
</VBox>