<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.baraja_cartas_gui.controladores.EstadisticasController" spacing="20" alignment="CENTER" style="-fx-padding: 20;">
    <Label text="Estadísticas de Palos Ganadores" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <GridPane fx:id="estadisticasGrid" hgap="20" vgap="10">
        <!-- Las estadísticas de los palos se generarán dinámicamente -->
    </GridPane>

    <Button text="Volver" onAction="#volver" style="-fx-padding: 10 20; -fx-font-size: 14px;" />
</VBox>