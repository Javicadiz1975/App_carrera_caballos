        <GridPane fx:id="raceTrack" alignment="CENTER" cacheShape="false" centerShape="false" maxHeight="400.0" maxWidth="700.0" prefHeight="326.0" prefWidth="267.0" scaleShape="false" style="-fx-padding: 10;" BorderPane.alignment="CENTER">
            <columnConstraints>
