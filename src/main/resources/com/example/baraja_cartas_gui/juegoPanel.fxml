<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: #f4f4f9;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.baraja_cartas_gui.controladores.JuegoPanelController">
    <!-- Título de la aplicación -->
    <top>
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2a9d8f;" text="Carrera de Caballos" BorderPane.alignment="CENTER" />
    </top>

    <!-- Imagen de la carta y descripción -->
    <left>
        <VBox alignment="CENTER" prefHeight="565.0" prefWidth="126.0" spacing="10.0" style="-fx-padding: 20;" BorderPane.alignment="CENTER">
            <ImageView fx:id="ImagenCarta" fitHeight="200.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, #264653, 10, 0.5, 2, 2);" />
            <Label fx:id="descripcionCarta" style="-fx-font-size: 16px; -fx-text-fill: #264653; -fx-font-weight: bold;" />
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
        </VBox>
    </left>

    <!-- Pista de carrera en el centro -->
    <center>
        <GridPane fx:id="raceTrack" alignment="CENTER" style="-fx-padding: 10; " BorderPane.alignment="CENTER">
            <columnConstraints>
                <!-- Primera columna (Salida) -->
                <ColumnConstraints halignment="CENTER" minWidth="50.0" prefWidth="50.0" />

                <!-- Columnas intermedias -->
                <ColumnConstraints halignment="CENTER" minWidth="50.0" prefWidth="50.0" />
                <ColumnConstraints halignment="CENTER" minWidth="50.0" prefWidth="50.0" />
                <ColumnConstraints halignment="CENTER" minWidth="50.0" prefWidth="50.0" />
                <ColumnConstraints halignment="CENTER" minWidth="50.0" prefWidth="50.0" />
                <ColumnConstraints halignment="CENTER" minWidth="50.0" prefWidth="50.0" />
                <ColumnConstraints halignment="CENTER" minWidth="50.0" prefWidth="50.0" />
                <ColumnConstraints halignment="CENTER" minWidth="50.0" prefWidth="50.0" />

                <!-- Última columna (Llegada) -->
                <ColumnConstraints halignment="CENTER" minWidth="50.0" prefWidth="50.0" />
            <ColumnConstraints />

            </columnConstraints>

            <rowConstraints>
                <RowConstraints maxHeight="85" minHeight="85" valignment="CENTER" />
                <RowConstraints maxHeight="85" minHeight="85" valignment="CENTER" />
                <RowConstraints maxHeight="85" minHeight="85" valignment="CENTER" />
                <RowConstraints maxHeight="85" minHeight="85" valignment="CENTER" />
            </rowConstraints>

            <!-- Etiqueta "Salida" en la primera columna -->
            <Label alignment="CENTER" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: black;" text="Salida" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.rowSpan="4" />

            <!-- Etiqueta "Llegada" en la última columna -->
            <Label alignment="CENTER" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: black;" text="Llegada" GridPane.columnIndex="9" GridPane.rowIndex="0" GridPane.rowSpan="4" />
         <BorderPane.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </BorderPane.margin>
        </GridPane>
    </center>

    <!-- Meta lateral derecha -->
    <right>

    </right>
    <bottom>
        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20" BorderPane.alignment="CENTER">
            <children>
                <!-- Imagen del croupier -->
                <ImageView fx:id="croupierImageView" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
               <HBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </HBox.margin></ImageView>

                <!-- Label para indicar el movimiento -->
                <Label fx:id="movementLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Esperando acción..." />
            </children>
        </HBox>
    </bottom>
</BorderPane>
