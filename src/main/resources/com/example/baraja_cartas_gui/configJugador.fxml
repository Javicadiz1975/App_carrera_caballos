<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<Pane prefHeight="379.0" prefWidth="632.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.baraja_cartas_gui.controladores.ConfigJugadoresController">
    <children>
        <VBox alignment="CENTER" layoutX="200.0" layoutY="50.0" prefWidth="400.0" spacing="10.0" style="-fx-padding: 20; -fx-background-color: #f4f4f9; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 4);">
            <children>
                <!-- Título -->
                <Text fx:id="tituloLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #333;" text="Configuración de Jugadores" />

                <!-- Contenedor para Nombre -->
                <HBox alignment="CENTER" spacing="15" style="-fx-padding: 5; -fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;">
                    <children>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Nombre:" />
                        <TextField fx:id="nombreField" promptText="Introduce el nombre" style="-fx-font-size: 14px; -fx-text-fill: #555;" />
                    </children>
                </HBox>

                <!-- Contenedor para Palos -->
                <HBox alignment="CENTER" spacing="15" style="-fx-padding: 5; -fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;">
                    <children>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Palo:" />
                        <ChoiceBox fx:id="paloChoiceBox" style="-fx-font-size: 14px; -fx-background-color: #f4f4f4; -fx-border-radius: 5;" />
                    </children>
                </HBox>

                <!-- Contenedor para Apuesta -->
                <HBox alignment="CENTER" spacing="15" style="-fx-padding: 5; -fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;">
                    <children>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Apuesta:" />
                        <TextField fx:id="apuestaField" promptText="Introduce la apuesta" style="-fx-font-size: 14px; -fx-text-fill: #555;" />
                    </children>
                </HBox>

                <!-- Botón -->
                <Button fx:id="botonAccion" onAction="#manejarBotonAccion" style="-fx-background-color: #0078d7; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20 10 20; -fx-background-radius: 5; -fx-font-weight: bold;" text="Configurar Próximo Jugador" />
            </children>
        </VBox>

        <!-- Imagen del croupier -->
        <VBox alignment="CENTER" layoutX="36.0" layoutY="89.0" prefHeight="200.0" prefWidth="150.0" spacing="10.0">
         <children>
                <ImageView fx:id="ImagenCarta" fitHeight="200.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, #264653, 10, 0.5, 2, 2);" />
         </children></VBox>
    </children>
</Pane>
